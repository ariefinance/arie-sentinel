# ARIE Sentinel production/pilot configuration reference.
# Placeholders only. Copy to a secret-managed runtime environment; never commit .env.

# Application
ARIE_ENV=production
ARIE_LOG_LEVEL=info
ARIE_CORS_ORIGINS=https://sentinel.example.test
ARIE_DATABASE_URL=postgresql+psycopg://sentinel:<password>@postgres.example.test:5432/sentinel

# Authentication
ARIE_DEV_AUTH=false
ARIE_OIDC_ISSUER=https://idp.example.test
ARIE_OIDC_AUDIENCE=sentinel-api
ARIE_OIDC_JWKS_URL=https://idp.example.test/.well-known/jwks.json
ARIE_OIDC_ROLES_CLAIM=roles
ARIE_OIDC_ANALYST_ROLE=sentinel-analyst
ARIE_OIDC_MANAGER_ROLE=sentinel-manager

# Live providers
ARIE_PROVIDER_MODE=live
ARIE_PROVIDER_TIMEOUT_SECONDS=15

# Corporate intelligence
ARIE_OPENCORPORATES_BASE_URL=https://api.opencorporates.com/v0.4
ARIE_OPENCORPORATES_API_KEY=<secret-if-issued>
ARIE_GLEIF_BASE_URL=https://api.gleif.org/api/v1

# Screening
ARIE_OPENSANCTIONS_BASE_URL=https://api.opensanctions.org
ARIE_OPENSANCTIONS_API_KEY=<secret>
ARIE_OPENSANCTIONS_DATASET=default

# Approved structured web/news search
ARIE_WEB_SEARCH_PROVIDER=structured
ARIE_WEB_SEARCH_BASE_URL=https://search.example.test/search
ARIE_WEB_SEARCH_API_KEY=<secret>

# Domain registration
ARIE_RDAP_BASE_URL=https://rdap.org
