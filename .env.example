# ─────────────────────────────────────────────────────────────────────────
# ARIE Sentinel — Example environment configuration
#
# This file DOCUMENTS the configuration Sentinel expects. It must contain
# NO REAL SECRETS, credentials, hostnames, or URLs — only obvious placeholders.
#
# Usage:  copy this file to `.env` and fill in real values locally.
#         `.env` is git-ignored and must NEVER be committed (public repo).
#
# Values are grouped by concern and aligned to the architecture's adapters
# and stores. Vendor names are intentionally NOT hardcoded — every external
# integration sits behind a swappable adapter (see docs/ARCHITECTURE.md).
# ─────────────────────────────────────────────────────────────────────────

# ── Application ────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=changeme-placeholder
LOG_LEVEL=info

# ── Database (PostgreSQL — single relational store of record) ──────────────
DATABASE_URL=postgresql://user:password@localhost:5432/arie_sentinel

# ── Object store (immutable raw source payloads) ───────────────────────────
# S3-compatible in production; a local filesystem stand-in is fine in dev.
# Stores large immutable blobs referenced by content_ref + content_hash.
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_BUCKET=arie-sentinel-sources
OBJECT_STORE_ACCESS_KEY=placeholder-access-key
OBJECT_STORE_SECRET_KEY=placeholder-secret-key

# ── Job runner (asynchronous investigation jobs) ───────────────────────────
# Phase 1 uses a Postgres-backed queue (FOR UPDATE SKIP LOCKED) — it shares
# DATABASE_URL above and needs no broker. No Redis/dedicated broker in Phase 1.

# ── Corporate registry provider (adapter: CorporateRegistryProvider) ───────
ARIE_OPENCORPORATES_API_KEY=your-key-here
ARIE_OPENCORPORATES_BASE_URL=https://api.opencorporates.com/v0.4
ARIE_GLEIF_BASE_URL=https://api.gleif.org/api/v1

# ── Screening provider (adapter: ScreeningProvider — sanctions/PEP/adverse) ─
# Vendor-neutral; screening matches never auto-decide, they route to review.
ARIE_OPENSANCTIONS_API_KEY=your-key-here
ARIE_OPENSANCTIONS_BASE_URL=https://api.opensanctions.org

# ── Domain / RDAP (adapter: DomainRegistrationProvider — RDAP-first) ────────
ARIE_RDAP_BASE_URL=https://rdap.org
# Optional WHOIS fallback when RDAP does not cover a TLD.
WHOIS_FALLBACK_ENABLED=false

# ── Model provider (adapter: ModelProvider — LLM, isolated) ────────────────
# Vendor-neutral: the model is isolated and swappable. Its output is never
# evidence by itself and can never change workflow state, gating, or screening.
MODEL_PROVIDER=placeholder-model-provider
MODEL_PROVIDER_API_KEY=your-key-here
MODEL_PROVIDER_BASE_URL=https://model.example.test/v1

# ── Authentication / IdP (internal users only; SSO/IdP at implementation) ──
ARIE_OIDC_ISSUER=https://idp.example.test
ARIE_OIDC_AUDIENCE=sentinel-api
ARIE_OIDC_JWKS_URL=https://idp.example.test/.well-known/jwks.json
