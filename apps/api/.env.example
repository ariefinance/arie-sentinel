# ARIE Sentinel API — example environment (placeholders only; NEVER commit a real .env)
# Copy to .env for local development. The repository is public: no real secrets.

# Application
ARIE_ENV=development
ARIE_LOG_LEVEL=info
# Comma-separated list of allowed CORS origins (the dev web app).
ARIE_CORS_ORIGINS=http://localhost:5173

# Database (PostgreSQL). Local dev default matches docker/dev Postgres.
ARIE_DATABASE_URL=postgresql+psycopg://arie:arie@localhost:5432/arie_sentinel

# Development identity (clearly-isolated dev-only auth until real OIDC IdP is selected).
# NEVER use ARIE_DEV_AUTH=true outside development.
ARIE_DEV_AUTH=true
ARIE_DEV_ANALYST_EMAIL=analyst@example.test
ARIE_DEV_MANAGER_EMAIL=manager@example.test

# Production auth boundary (OIDC) — placeholders; not wired in Stage 1.
# ARIE_OIDC_ISSUER=https://idp.example.test
# ARIE_OIDC_CLIENT_ID=your-client-id
# ARIE_OIDC_CLIENT_SECRET=your-client-secret
# ARIE_SESSION_SECRET=changeme-placeholder

# Providers — Stage 1 uses deterministic FIXTURE implementations only.
# Real providers are wired in a later stage; these remain placeholders.
ARIE_PROVIDER_MODE=fixture
# ARIE_REGISTRY_PROVIDER_BASE_URL=https://registry.example.test/api
# ARIE_REGISTRY_PROVIDER_API_KEY=your-key-here
# ARIE_SCREENING_PROVIDER_BASE_URL=https://screening.example.test/api
# ARIE_SCREENING_PROVIDER_API_KEY=your-key-here
# ARIE_MODEL_PROVIDER=placeholder-model-provider
# ARIE_MODEL_PROVIDER_API_KEY=your-key-here
