# ARIE Sentinel API — example environment (placeholders only; NEVER commit a real .env)
# Copy to .env for local development. The repository is public: no real secrets.

# Application
ARIE_ENV=development
ARIE_LOG_LEVEL=info
# Comma-separated list of allowed CORS origins (the dev web app).
ARIE_CORS_ORIGINS=http://localhost:5173

# Database (PostgreSQL). Local dev default matches docker/dev Postgres.
ARIE_DATABASE_URL=postgresql+psycopg://arie:arie@localhost:5432/arie_sentinel

# Development identity (clearly-isolated dev-only auth until real OIDC IdP is selected).
# NEVER use ARIE_DEV_AUTH=true outside development.
ARIE_DEV_AUTH=true
ARIE_DEV_ANALYST_EMAIL=analyst@example.test
ARIE_DEV_MANAGER_EMAIL=manager@example.test

# Production OIDC bearer-token validation.
# ARIE_OIDC_ISSUER=https://idp.example.test
# ARIE_OIDC_AUDIENCE=sentinel-api
# ARIE_OIDC_JWKS_URL=https://idp.example.test/.well-known/jwks.json
# ARIE_OIDC_ROLES_CLAIM=roles
# ARIE_OIDC_ANALYST_ROLE=sentinel-analyst
# ARIE_OIDC_MANAGER_ROLE=sentinel-manager

# Providers. Use fixture for deterministic development/tests, live for production adapters.
ARIE_PROVIDER_MODE=fixture
# ARIE_OPENCORPORATES_BASE_URL=https://api.opencorporates.com/v0.4
# ARIE_OPENCORPORATES_API_KEY=your-key-here
# ARIE_GLEIF_BASE_URL=https://api.gleif.org/api/v1
# ARIE_OPENSANCTIONS_BASE_URL=https://api.opensanctions.org
# ARIE_OPENSANCTIONS_API_KEY=your-key-here
# ARIE_OPENSANCTIONS_DATASET=default
# ARIE_RDAP_BASE_URL=https://rdap.org
# Approved structured search endpoint returning {results:[{title,url,content,...}]}.
# ARIE_WEB_SEARCH_BASE_URL=https://search.example.test/search
# ARIE_WEB_SEARCH_API_KEY=your-key-here
# ARIE_PROVIDER_TIMEOUT_SECONDS=15
